# Service checkout used as the Docker build context.
SMIRKLY_AUTH_CONTEXT=../smirkly-auth
SMIRKLY_CHAT_CONTEXT=../smirkly-chat
# userver v3.0 image is currently amd64-only; Docker Desktop emulates it on Apple Silicon.
SMIRKLY_AUTH_PLATFORM=linux/amd64
SMIRKLY_CHAT_PLATFORM=linux/amd64

# Loopback-bound developer ports.
POSTGRES_PORT=55432
CHAT_POSTGRES_PORT=55433
SMIRKLY_AUTH_PORT=18080
SMIRKLY_CHAT_PORT=18081
MAILPIT_HTTP_PORT=8025
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
